# ==========================================
# MahalFlow Backend — Environment Template
# Copy to .env and fill in secrets. This template IS committed.
# ==========================================

# --- Server ---
PORT=8080
# Use exactly "development" for local work. Anything else (unset, "prod",
# "production", typos) is treated as production: test mode and the standalone
# commit fallback are forced off.
ENV=development
# Comma-separated browser origins allowed by CORS (web-admin). Never "*".
# Unset: ENV=development allows localhost dev servers, anything else sends no
# CORS headers.
CORS_ORIGINS=

# --- Datastores ---
MONGO_URI=mongodb://localhost:27017
DB_NAME=mahalflow
REDIS_ADDR=localhost:6379

# --- Auth ---
# REQUIRED, >= 32 random characters (e.g. `openssl rand -hex 32`). The server
# refuses to start without it; there is no default. The only exception is
# ENV=development together with AUTH_DEV_BYPASS=true, which uses a random
# per-process key.
JWT_SECRET=
# Firebase project for phone-OTP ID-token verification (/auth/resolve, /auth/register).
# Defaults to the FCM service account's project_id.
FIREBASE_PROJECT_ID=
# Local development ONLY: trust a posted phone when no Firebase ID token is sent.
# Ignored when ENV=production.
AUTH_DEV_BYPASS=false

# --- Payment Gateway ---
# Default OFF. ON simulates the gateway (payments "succeed" with no money
# moving) and is honoured ONLY when ENV=development; in any other ENV it is
# ignored with an error log. Never set ON on a deployed environment.
PAYMENT_TEST_MODE=OFF
# Development only: allow non-atomic ledger writes on a standalone MongoDB
# (no replica set). Ignored unless ENV=development. Production needs a replica set.
ALLOW_STANDALONE_COMMIT=false
PG_API_URL=
PG_API_KEY=
PG_SALT=
PG_RETURN_URL=http://localhost:8080/api/v1/webhooks/pg
# PayU Merchant Web Service host (verify_payment, refunds, SI). Empty = derived
# from PG_API_URL: https://test.payu.in for the sandbox, https://info.payu.in otherwise.
PG_INFO_API_URL=
# How browsers reach this API; used for the signed public checkout links
# (payment_url / mandate_url). Default http://localhost:$PORT.
PUBLIC_BASE_URL=

# --- WhatsApp Business Cloud API (Meta) ---
# Get these from Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Echoed back to Meta during webhook subscription handshake (GET hub.challenge)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret — used to validate X-Hub-Signature-256 on inbound webhooks. Fill from App Dashboard > Settings > Basic.
# Without it the inbound webhook rejects everything rather than trusting unsigned callers.
WHATSAPP_APP_SECRET=
# Approved template names. Leave EMPTY until Meta approves them: the service then
# falls back to free-form text, which only reaches members inside an open 24h window.
# Once approved, set these and templated sending starts with no code change.
WHATSAPP_TEMPLATE_DUES_REMINDER=
WHATSAPP_TEMPLATE_RECEIPT=
# Set true to log messages without calling the Graph API (safe rehearsal on real data).
WHATSAPP_DRY_RUN=false
